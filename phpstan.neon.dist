includes:
	- phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src/
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        -
            message: '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition::children\(\)#'
            reportUnmatched: false
        -
            message: '#PHPDoc tag @var with type Softspring\\Component\\MimeTranslatable\\ExampleEmailInterface is not subtype of native type string\|null\.#'
            reportUnmatched: false
        - '#Call to an undefined method Doctrine\\ORM\\EntityRepository::findOneBy#'