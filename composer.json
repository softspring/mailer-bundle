{
    "name": "softspring/mailer-bundle",
    "description": "This bundle provides some features that ease mailing for Symfony projects.",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.5",
        "doctrine/orm": "^2.10 | ^3.0",
        "softspring/components": "^6.0@dev",
        "softspring/doctrine-target-entity-resolver": "^6.0@dev",
        "softspring/mime-translatable": "^6.0@dev",
        "symfony/form": "^6.4|^7.3",
        "symfony/mailer": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "softspring/user-bundle": "^6.0@dev",
        "swiftmailer/swiftmailer": "^6.3",
        "symfony/console": "^6.4|^7.3",
        "symfony/framework-bundle": "^6.4|^7.3",
        "symfony/translation": "^6.4|^7.3",
        "symfony/yaml": "^6.4|^7.3",
        "twig/twig": "*"
    },
    "suggest": {
        "softspring/admin-bundle": "Use softspring admin templates",
        "twig/cssinliner-extra": "Use css inliner",
        "twig/inky-extra": "Use Inky mailing templates"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\MailerBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
